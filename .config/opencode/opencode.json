{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./plugins/telegram-notify.ts"],
  "model": "zai/glm-5.1",
  "share": "disabled",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "secrets/*": "deny"
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "https://api.proxyapi.ru/anthropic/v1",
        "apiKey": "{env:PROXYAPI_API_KEY}"
      }
    },
    "google": {
      "options": {
        "baseURL": "https://api.proxyapi.ru/google/v1beta",
        "apiKey": "{env:PROXYAPI_API_KEY}"
      }
    },
    "zai": {
      "options": {
        "baseURL": "https://naomi.nau.im/api",
        "apiKey": "{env:ZAI_API_KEY}"
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  }
}
