{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "https://api.proxyapi.ru/anthropic/v1",
        "apiKey": "{env:PROXYAPI_API_KEY}"
      }
    },
    "google": {
      "options": {
        "baseURL": "https://api.proxyapi.ru/google/v1beta",
        "apiKey": "{env:PROXYAPI_API_KEY}"
      }
    },
    "zai": {
      "options": {
        "baseURL": "https://naomi.nau.im/api",
        "apiKey": "{env:ZAI_API_KEY}"
      }
    }
  },
  "mcp": {
    "yandex-cloud-documentation": {
      "type": "remote",
      "url": "https://docs.mcp.cloud.yandex.net/mcp",
      "enabled": true
    }
  }
}
